@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":ModelManager" as ModelManager MODEL_COLOR
participant "undoHistory" as UndoHistory MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
end box

[-> Model : undo()
activate Model

Model -> ModelManager : undo()
activate ModelManager

alt undoHistory is empty
    ModelManager --> Model : false
else undoHistory contains a saved state
    ModelManager -> UndoHistory : pop()
    UndoHistory --> ModelManager : previous AddressBook

    ModelManager -> AddressBook : resetData(previousState)
    ModelManager -> ModelManager : reapply currentPredicate
    ModelManager --> Model : true
end

deactivate ModelManager

[<-- Model
deactivate Model

@enduml
